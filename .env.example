# ---------------------------------------------------------------------------
# Dictionary 2.0 — environment variables (copy to .env and adjust)
# ---------------------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# Comma separated list of allowed CORS origins (leave empty to allow all in dev)
CLIENT_ORIGIN=http://localhost:5173

# Dictionary provider in use: free | (future providers can be registered here)
DICTIONARY_PROVIDER=free

# Base URL of the upstream dictionary provider
DICTIONARY_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en

# Upstream request timeout in milliseconds
DICTIONARY_TIMEOUT_MS=8000

# Node environment
NODE_ENV=development

# ---------------------------------------------------------------------------
# Client (Vite) — only needed when the frontend is NOT served by the proxy.
# Create client/.env if you want to point the frontend somewhere else.
# ---------------------------------------------------------------------------
# VITE_API_URL=http://localhost:5000
